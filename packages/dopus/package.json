{
  "name": "dopus",
  "version": "0.0.0",
  "description": "Drop an AI agent into your existing Next.js app — your server functions become its tools.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akodm/dopus.git",
    "directory": "packages/dopus"
  },
  "keywords": [
    "nextjs",
    "ai",
    "agent",
    "llm",
    "server-actions",
    "ai-sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "dopus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/provider": "4.0.37",
    "@types/node": "^24.0.0",
    "ai": "7.0.166",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
