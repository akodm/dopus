{
  "name": "dopus",
  "version": "0.2.9",
  "description": "A lightweight agent for Next.js: your existing server functions become its tools, run with the signed-in user's permissions.",
  "license": "MIT",
  "author": "akodm",
  "homepage": "https://github.com/akodm/dopus#readme",
  "bugs": {
    "url": "https://github.com/akodm/dopus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akodm/dopus.git",
    "directory": "packages/dopus"
  },
  "keywords": [
    "nextjs",
    "next.js",
    "ai",
    "agent",
    "llm",
    "server-actions",
    "ai-sdk",
    "openai",
    "anthropic",
    "gemini",
    "chatbot",
    "lightweight",
    "app-router",
    "tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "bin": {
    "dopus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.templates.json",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\" && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/provider": "4.0.37",
    "@ai-sdk/react": "4.0.170",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "ai": "7.0.166",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
